# macOS / Xcode
.DS_Store
DerivedData/
build/
*.xcuserstate
xcuserdata/
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/

# Swift Package Manager
.build/
.swiftpm/xcode/xcuserdata/
Packages/*/.build/
Packages/*/.swiftpm/xcode/xcuserdata/

# Build products
*.ipa
*.dSYM
*.dSYM.zip
*.hmap
*.profraw

# IDE
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Credentials — NEVER commit
.env
*.env
*credential*
!Sources/**/Credentials.swift

# Local scratch
_scratch/
*Fixtures.txt
tmp/
*.log

# Python 缓存（预检工具的运行产物，不入库）
__pycache__/
*.pyc
